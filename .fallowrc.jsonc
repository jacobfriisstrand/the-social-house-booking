{
  "$schema": "./node_modules/fallow/schema.json",
  // Real runtime roots no plugin or manifest declares: the scheduled Netlify
  // function, standalone scripts, and the boot-time env self-check.
  "entry": ["lib/env.selfcheck.ts", "netlify/functions/**", "scripts/**"],
  // Generated or non-source trees, excluded from every analysis:
  // - database.types.ts is regenerated by `npm run db:types`
  // - docs/design/canvas holds exported design-canvas mockups with inline
  //   scripts, not first-party source
  // - .agents holds skill markdown, not project source
  "ignorePatterns": [
    "lib/supabase/database.types.ts",
    "docs/design/canvas/**",
    ".agents/**"
  ],
  // Exports referenced within their own file count as used (shadcn primitives
  // keep their full surface; internal helpers stay un-exported in lib).
  "ignoreExportsUsedInFile": true,
  // shadcn composition surface kept for upcoming screens even before use
  // (DESIGN.md forms: label, hint, and error slots inside Field).
  "ignoreExports": [
    {
      "file": "components/ui/field.tsx",
      "exports": [
        "FieldContent",
        "FieldDescription",
        "FieldLegend",
        "FieldSeparator",
        "FieldSet",
        "FieldTitle"
      ]
    },
    { "file": "components/ui/alert.tsx", "exports": ["AlertAction"] },
    {
      "file": "components/ui/breadcrumb.tsx",
      "exports": ["BreadcrumbEllipsis"]
    },
    {
      "file": "components/ui/attachment.tsx",
      "exports": ["AttachmentGroup"]
    },
    { "file": "components/ui/card.tsx", "exports": ["CardAction"] },
    {
      "file": "components/ui/dialog.tsx",
      "exports": [
        "DialogClose",
        "DialogDescription",
        "DialogFooter",
        "DialogHeader"
      ]
    },
    { "file": "components/ui/empty.tsx", "exports": ["EmptyContent"] },
    {
      "file": "components/ui/popover.tsx",
      "exports": ["PopoverDescription", "PopoverHeader", "PopoverTitle"]
    },
    {
      "file": "components/ui/select.tsx",
      "exports": ["SelectLabel", "SelectSeparator"]
    },
    {
      "file": "components/ui/sheet.tsx",
      "exports": ["SheetClose", "SheetDescription", "SheetFooter"]
    },
    {
      "file": "components/ui/sidebar.tsx",
      "exports": [
        "SidebarGroupAction",
        "SidebarInput",
        "SidebarMenuAction",
        "SidebarMenuBadge",
        "SidebarMenuSkeleton",
        "SidebarMenuSub",
        "SidebarMenuSubButton",
        "SidebarMenuSubItem",
        "SidebarRail",
        "SidebarSeparator"
      ]
    },
    { "file": "components/ui/tooltip.tsx", "exports": ["TooltipProvider"] },
    {
      "file": "components/ui/table.tsx",
      "exports": ["TableCaption", "TableFooter"]
    }
  ],
  // Kept intentionally before first use, not dead code:
  // - lib/format.ts: formatDateTime lands with the booking overview (#8)
  "ignoreFindings": ["lib/format.ts"],
  "duplicates": {
    // :root and .dark repeat the generated shadcn token values on purpose;
    // .dark exists only so components compile (DESIGN.md: no dark mode in v1).
    "ignore": ["app/globals.css"]
  }
}
