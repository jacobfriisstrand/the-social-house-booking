# Copy to .env.local for local development. Never commit real values.
# Every variable is read exactly once, in lib/env.ts (zod-validated at boot).
# Deployed values: APP_ENV and NEXT_PUBLIC_SITE_URL come from netlify.toml per
# context; everything else is set on the Netlify site per context with
# `netlify env:set` (scripts/setup-netlify-env.sh walks through it).
#   production     = main            -> Supabase "PROD | The Social House Booking"
#   branch-deploy  = develop         -> Supabase "the-social-house-development"
#   deploy-preview = pull requests   -> same values as develop

# --- App ---
APP_ENV=development                      # development | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000     # per context in netlify.toml; previews fall back to DEPLOY_PRIME_URL

# --- Supabase ---
# Local: `supabase start`, then `supabase status -o env` (API_URL, PUBLISHABLE_KEY, SECRET_KEY).
# Cloud: Project Settings -> Data API (URL) and API Keys (sb_publishable_…, sb_secret_…).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=    # sb_publishable_… (public)
SUPABASE_SECRET_KEY=                     # sb_secret_… — server only, see docs/agents/supabase.md allowlist

# --- Resend ---
# Development account sends from tsh-dev.jacobfri.is; production must move to
# thesocialhouse.dk once that domain is verified in Resend.
RESEND_API_KEY=                          # development key locally and on develop; production key on main
RESEND_FROM=The Social House <booking@tsh-dev.jacobfri.is>   # production: booking@thesocialhouse.dk
RESEND_WEBHOOK_SECRET=                   # whsec_… from the webhook registered per deploy URL; empty locally
EMAIL_REDIRECT_TO=                       # development only: every outbound mail goes to these comma-separated addresses instead

# --- Jobs ---
JOB_SECRET=                              # bearer secret for POST /api/jobs/*; one value in all contexts

# --- Sentry (project tsh-booking; leave empty locally: Sentry is off without a DSN) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                       # sntrys_… organisation token; Netlify build only, uploads source maps
