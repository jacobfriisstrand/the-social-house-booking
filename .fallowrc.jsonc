{
  "$schema": "./node_modules/fallow/schema.json",
  // Real runtime roots no plugin or manifest declares: the scheduled Netlify
  // function and the standalone scripts.
  "entry": ["netlify/functions/**", "scripts/**"],
  // Generated or non-source trees, excluded from every analysis:
  // - database.types.ts is regenerated by `npm run db:types`
  // - docs/design/canvas holds exported design-canvas mockups with inline
  //   scripts, not first-party source
  // - .agents holds skill markdown, not project source
  "ignorePatterns": [
    "lib/supabase/database.types.ts",
    "docs/design/canvas/**",
    ".agents/**"
  ],
  // Exports referenced within their own file count as used (shadcn primitives
  // keep their full surface; internal helpers stay un-exported in lib).
  "ignoreExportsUsedInFile": true,
  // shadcn composition surface kept for upcoming screens even before use
  // (DESIGN.md forms: label, hint, and error slots inside Field).
  "ignoreExports": [
    {
      "file": "components/ui/field.tsx",
      "exports": [
        "FieldContent",
        "FieldDescription",
        "FieldLegend",
        "FieldSeparator",
        "FieldSet",
        "FieldTitle"
      ]
    },
    { "file": "components/ui/alert.tsx", "exports": ["AlertAction"] },
    // Toggle ships beside ToggleGroup (shadcn adds them together); the
    // group is what the screens compose, the lone toggle stays available.
    { "file": "components/ui/toggle.tsx", "exports": ["Toggle"] },
    { "file": "components/ui/table.tsx", "exports": ["TableFooter"] },
    {
      "file": "components/ui/breadcrumb.tsx",
      "exports": ["BreadcrumbEllipsis"]
    },
    {
      "file": "components/ui/attachment.tsx",
      "exports": ["AttachmentGroup"]
    },
    { "file": "components/ui/card.tsx", "exports": ["CardAction"] },
    {
      "file": "components/ui/progress.tsx",
      "exports": ["ProgressLabel", "ProgressValue"]
    },
    {
      "file": "components/ui/input-group.tsx",
      "exports": ["InputGroupText", "InputGroupTextarea"]
    },
    {
      "file": "components/ui/dialog.tsx",
      "exports": [
        "DialogClose",
        "DialogDescription",
        "DialogFooter",
        "DialogHeader"
      ]
    },
    { "file": "components/ui/empty.tsx", "exports": ["EmptyContent"] },
    {
      "file": "components/ui/input-otp.tsx",
      "exports": ["InputOTPSeparator"]
    },
    {
      "file": "components/ui/popover.tsx",
      "exports": ["PopoverDescription", "PopoverHeader", "PopoverTitle"]
    },
    {
      "file": "components/ui/select.tsx",
      "exports": ["SelectLabel", "SelectSeparator"]
    },
    {
      "file": "components/ui/sheet.tsx",
      "exports": ["SheetClose", "SheetDescription", "SheetFooter"]
    },
    {
      "file": "components/ui/sidebar.tsx",
      "exports": [
        "SidebarGroupAction",
        "SidebarInput",
        "SidebarMenuAction",
        "SidebarMenuBadge",
        "SidebarMenuSkeleton",
        "SidebarMenuSub",
        "SidebarMenuSubButton",
        "SidebarMenuSubItem",
        "SidebarRail",
        "SidebarSeparator"
      ]
    },
    { "file": "components/ui/tooltip.tsx", "exports": ["TooltipProvider"] },
    {
      "file": "components/ui/table.tsx",
      "exports": ["TableCaption", "TableFooter"]
    }
  ],
  // Kept intentionally before first use, not dead code:
  // - lib/bookings/admin-cancel-actions.ts: cancelBookingAsAdmin is wired to the
  //   admin bookings view (2026-10-14); waiveCancellationFee still waits for its screen
  "ignoreFindings": ["lib/bookings/admin-cancel-actions.ts"],
  // netlify-cli is a manual CLI tool (docs/agents/deploy.md), never imported
  // from source, so the unused-devDependency finding is a false positive.
  "ignoreDependencies": ["netlify-cli"],
  // Accepted complexity, kept visible as numeric ceilings (the schema's
  // own alternative to binary suppressions). The booking overview's table
  // and view are one client component each because the selection state,
  // bulk actions, controls and pending-skeleton wiring share closures;
  // splitting them is a queued refactor, not this branch.
  "health": {
    "thresholdOverrides": [
      {
        "files": ["components/bookings/admin-bookings-table.tsx"],
        "maxCyclomatic": 24,
        "maxCognitive": 48,
        "reason": "AdminBookingsTable: selection, bulk actions and row overlays share one component's closures; split is queued."
      },
      {
        "files": ["components/bookings/admin-bookings-view.tsx"],
        "maxCognitive": 24,
        "maxCrap": 250,
        "reason": "AdminBookingsView: every URL-writing control rides one transition; the component split is queued with the table's."
      },
      {
        "files": ["components/ui/toggle-group.tsx"],
        "maxCrap": 32,
        "reason": "shadcn-owned composition block, kept as added (DESIGN.md: ui components are owned, not restructured)."
      },
      {
        "files": ["components/settings/hero-image-form.tsx"],
        "maxCognitive": 20,
        "maxCrap": 48,
        "reason": "The hero upload flow (#89) is exercised end to end in the browser check (pick, save, replacement, orphan rollback) and its payload boundary is unit-tested; the CRAP estimate credits no coverage."
      },
      {
        "files": ["lib/settings/actions.ts"],
        "maxCrap": 48,
        "reason": "updatePublicHeroImage is thin DB wiring over a schema-validated payload; the pointer swap runs under 165_rls_site_images.sql and the browser flow."
      },
      {
        "files": ["components/companies/company-table.tsx"],
        "maxCrap": 48,
        "reason": "CompanyRowCells is the table's cell list: one ternary per optional column plus the row tick; the columns and their widths are exercised in the admin browser check and the widths come from the stated colgroup."
      },
      {
        "files": ["lib/outlook/sync.ts"],
        "maxCrap": 48,
        "reason": "payloadOf is the Graph payload mapper; the sync module is covered by lib/outlook/sync.test.ts and the dirty-mark trigger suite (205_calendar_dirty_marks.sql)."
      },
      {
        "files": ["netlify/functions/common/job-call.mts"],
        "maxCrap": 48,
        "reason": "callScheduledJob is pinned by netlify/functions/common/job-call.test.mts (five cases, the host-named 404 included); the estimator does not credit .mts test imports."
      },
      {
        "files": ["components/bookings/filter-row.tsx"],
        "maxCyclomatic": 20,
        "maxCognitive": 24,
        "maxCrap": 250,
        "reason": "The filter row's controls write the URL in one transition; the picker's draft/applied split mirrors the admin table's selection state. The split is queued with the table's."
      },
      {
        "files": ["components/bookings/admin-calendar-grid.tsx"],
        "maxCrap": 32,
        "reason": "AdminCalendarGrid: the calendar's cell blocks and the popover's entry list ride the shared overlay state machine; the split is queued with the table's."
      },
      {
        "files": ["components/bookings/booking-form.tsx"],
        "maxCognitive": 20,
        "reason": "BookingForm: the booking flow's steps share one form state; the split is queued with the table's."
      }
    ]
  },
  "duplicates": {
    // :root and .dark repeat the generated shadcn token values on purpose;
    // .dark exists only so components compile (DESIGN.md: no dark mode in v1).
    "ignore": ["app/globals.css"]
  }
}
