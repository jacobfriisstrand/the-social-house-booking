# Copy to .env.local for local development. Never commit real values.
# Real values live in Netlify (per deploy context) and GitHub Environments.
# Every variable is read exactly once, in lib/env.ts (zod-validated at boot).

# --- App ---
APP_ENV=development                      # development | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (local values come from `supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=    # anon / publishable key
SUPABASE_SECRET_KEY=                     # service role / secret key — server only, see docs/agents/supabase.md allowlist

# --- Resend ---
RESEND_API_KEY=                          # development key locally and on develop; production key on main
RESEND_FROM=The Social House <booking@thesocialhouse.dk>
RESEND_WEBHOOK_SECRET=                   # verifies POST /api/webhooks/resend
EMAIL_REDIRECT_TO=                       # development only: every outbound mail is redirected here

# --- Jobs ---
JOB_SECRET=                              # bearer secret for POST /api/jobs/*

# --- Sentry (leave empty locally: Sentry is off without a DSN) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                       # Netlify build only, uploads source maps
