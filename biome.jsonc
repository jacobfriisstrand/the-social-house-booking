{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "!.agents",
      "!.claude",
      "!lib/supabase/database.types.ts",
      "!docs/design/canvas"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noProcessEnv": "error"
      }
    }
  },
  // noProcessEnv exemptions live here. When the Sentry milestone lands, add
  // next.config.ts, instrumentation.ts and sentry.*.config.ts — they read
  // process.env by design (docs/agents/stack.md).
  "overrides": [
    {
      "includes": ["lib/env.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    // components/ui/ is generated shadcn source (owned per docs/agents/ui.md). Registry
    // updates would clobber hand-patches, so its known lint noise is suppressed here
    // instead of edited away. Feature code keeps full strictness.
    {
      "includes": ["components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noLeakedRender": "off",
            "noUnnecessaryConditions": "off"
          },
          "style": {
            "useDestructuring": "off"
          }
        }
      }
    }
  ]
}
