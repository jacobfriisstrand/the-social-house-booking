# Copy to .env.local for local development. Never commit real values.
# Tracked template: every app variable is declared once here and read exactly
# once, in lib/env.ts (zod-validated at boot; lib/env.selfcheck.ts counts them).
# Real values live in .env.local (gitignored) and the shared password-manager .env.

# ----- Local development (what npm run dev reads) -----
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase, LOCAL (supabase start / db reset) — the seed demo logins live here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=    # sb_publishable_… from `supabase status -o env`
SUPABASE_SECRET_KEY=                     # sb_secret_… — server only, see docs/agents/supabase.md allowlist
SUPABASE_DEV_DB_PASSWORD=
SUPABASE_DEV_ANON_KEY=
SUPABASE_DEV_SERVICE_ROLE_KEY=

# Resend, development account (domain tsh-dev.jacobfri.is)
RESEND_API_KEY=                          # development key locally and on develop; production key on main
RESEND_FROM=The Social House <booking@tsh-dev.jacobfri.is>   # production: booking@thesocialhouse.dk
RESEND_WEBHOOK_SECRET=                   # whsec_… from the webhook registered per deploy URL; empty locally
EMAIL_REDIRECT_TO=                       # development only: every outbound mail goes to these comma-separated addresses instead

# Jobs (same value as on Netlify)
JOB_SECRET=                              # bearer secret for POST /api/jobs/*
# Sentry (project tsh-booking, org the-social-house). Empty DSN = Sentry off locally.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_WEBHOOK_SECRET=                   # production context only; see app/api/webhooks/sentry
GITHUB_ISSUES_TOKEN=                     # production context only; fine-grained PAT, Issues: read and write

# ----- Production values (set on Netlify; here for reference only) -----
PROD_NEXT_PUBLIC_SITE_URL=
PROD_NEXT_PUBLIC_SUPABASE_URL=
PROD_NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PROD_SUPABASE_SECRET_KEY=
PROD_NEXT_PUBLIC_SENTRY_DSN=

# ----- CLI tokens (not app variables) -----
SUPABASE_ACCESS_TOKEN=
SENTRY_USER_TOKEN=
