{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!.agents",
      "!.claude",
      "!lib/supabase/database.types.ts",
      "!docs/design/canvas"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noProcessEnv": "error"
      }
    }
  },
  // noProcessEnv exemptions live here: lib/env.ts is the validating reader;
  // proxy.ts runs in Next's sandbox before .env.local is injected, so it must
  // read process.env itself (and skips the session refresh when unset); and
  // scripts/create-admin.ts runs under plain Node outside Next. When the
  // Sentry milestone lands, add next.config.ts, instrumentation.ts and
  // sentry.*.config.ts — they read process.env by design (docs/agents/stack.md).
  "overrides": [
    {
      "includes": [
        "lib/env.ts",
        "netlify/functions/*.mts",
        "scripts/create-admin.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    // env.selfcheck.ts is a standalone boot self-check (run manually), not a
    // vitest suite; its top-level node:assert calls are intentional.
    {
      "includes": ["lib/env.selfcheck.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off"
          }
        }
      }
    },
    // components/ui/ is generated shadcn source (owned per docs/agents/ui.md). Registry
    // updates would clobber hand-patches, so its known lint noise is suppressed here
    // instead of edited away. Feature code keeps full strictness.
    {
      "includes": ["components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noLeakedRender": "off",
            "noUnnecessaryConditions": "off"
          },
          "style": {
            "useDestructuring": "off"
          }
        }
      }
    }
  ]
}
